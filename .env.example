# === Ollama Configuration (Local GPU Model) ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
# Timeout in seconds - increased for long generation tasks
OLLAMA_TIMEOUT=600
# GPU layers: -1 = all layers on GPU, 0 = CPU only, N = first N layers on GPU
OLLAMA_GPU_LAYERS=-1

# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
BASE_URL=https://openrouter.ai/api/v1
API_MODEL_1=mistralai/ministral-3b
API_MODEL_2=liquid/lfm2-8b-a1b
API_MODEL_3=nvidia/nemotron-nano-9b-v2
API_MODEL_4=openai/gpt-oss-safeguard-20b
OPENAI_TIMEOUT=300
OPENAI_MAX_RETRIES=3

ENSEMBLE_N_REPEATS=3
ENSEMBLE_BASE_TEMPERATURE=0.2
ENSEMBLE_JUDGE_TEMPERATURE=0.0
EXTRACTION_MAX_WORKERS=3

DATABASE_URL=sqlite:///./data/clinical_trials.db
DB_ECHO=false

LOG_LEVEL=INFO
LOG_DIR=./logs